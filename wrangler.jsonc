{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "movie-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 300 API calls per minute per visitor (period must be 10 or 60 seconds).
  "ratelimits": [
    {
      "name": "LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    },
    // Sign-in, sign-up and anything that sends an email: 10 tries per minute per visitor.
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reel",
      "database_id": "f9254f99-b1d4-47a8-8e9d-006e872a58b3"
    }
  ]
}
